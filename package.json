{
  "name": "agent-context-card",
  "version": "0.5.0",
  "type": "module",
  "description": "Deterministic context projection for long-running coding-agent sessions",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./core": "./src/core/index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "eval:pi:ten-turn": "node scripts/evaluation/run.mjs --config evaluation/configs/pi-ten-turn-mixed.json",
    "eval:pi:nano-low": "node scripts/evaluation/run.mjs --config evaluation/configs/pi-ten-turn-mixed.json --model ai-inference-router/openai/gpt-5-nano --thinking low",
    "eval:pi:nano-low-framing": "node scripts/evaluation/run.mjs --config evaluation/configs/pi-ten-turn-plan-framing.json --model ai-inference-router/openai/gpt-5-nano --thinking low",
    "eval:pi:plan-phase": "node scripts/evaluation/run.mjs --config evaluation/configs/pi-plan-phase-experiment.json",
    "eval:swebench:pilot": "node scripts/evaluation/run.mjs --config evaluation/benchmarks/swebench-verified-sympy-18211.json",
    "eval:swebench:pilot2": "node scripts/evaluation/run.mjs --config evaluation/benchmarks/swebench-verified-sympy-21930.json",
    "grade:swebench": "node scripts/evaluation/grade-swebench.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "prepublishOnly": "node scripts/guard-publish.mjs"
  },
  "keywords": [
    "coding-agent",
    "context-management",
    "context-window",
    "llm",
    "pi",
    "pi-extension",
    "pi-package",
    "token-optimization",
    "task-card"
  ],
  "author": "chkrishna2001",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chkrishna2001/Agent-Context-Card.git"
  },
  "homepage": "https://github.com/chkrishna2001/Agent-Context-Card#readme",
  "bugs": {
    "url": "https://github.com/chkrishna2001/Agent-Context-Card/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.0.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
